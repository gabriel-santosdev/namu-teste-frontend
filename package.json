{
  "name": "namu-conteudos",
  "private": true,
  "description": "Biblioteca de conteúdos de bem-estar da Namu — web (React) e mobile (React Native) consumindo a mesma API.",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @namu/shared && npm run typecheck -w web"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=22.11"
  }
}
